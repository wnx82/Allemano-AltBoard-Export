<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AltBoardSync</AssemblyName>
    <!-- Produite par tools/make-icon.mjs. -->
    <ApplicationIcon>AltBoardSync.ico</ApplicationIcon>
    <!-- Échelle d'affichage par écran, et pas de console au double-clic. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- dotnet publish : un seul exécutable autonome, aucun runtime .NET requis sur le PC cible. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AltBoardSync.Core\AltBoardSync.Core.csproj" />
  </ItemGroup>

</Project>
