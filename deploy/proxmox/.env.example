# Variables de la pile Komodo « wow-altboard » (komodoprox). Elles se saisissent dans
# l'environnement de la pile, que Komodo écrit dans deploy/proxmox/.env à chaque déploiement.
# Ne jamais commiter de valeur réelle.

# Mot de passe du rôle PostgreSQL de la pile. Hexadécimal uniquement, il entre tel quel dans l'URL
# de connexion : openssl rand -hex 24. Dans Komodo, c'est le secret WOW_ALTBOARD_DB_PASSWORD,
# référencé par [[WOW_ALTBOARD_DB_PASSWORD]].
WOW_DB_PASSWORD=CHANGER

WOW_APP_ORIGIN=https://wow.ekreativ.be
# Laisser vide sur un sous-domaine dédié ; fixé à la construction de l'image.
WOW_BASE_PATH=
# Cloudflare pose cet en-tête devant le tunnel.
WOW_TRUSTED_IP_HEADER=cf-connecting-ip
# Adresse et port d'écoute sur CT 102, visés par l'entrée du tunnel Cloudflare. L'adresse du
# réseau local, pas 0.0.0.0 : le port serait aussi ouvert sur l'interface WireGuard.
WOW_BIND_IP=10.0.0.15
WOW_HOST_PORT=3016

# État des serveurs WoW Forever EU (docs/SERVER-STATUS.md) : « hôte:port », séparées par des
# virgules. Vides : rien n'est sondé, l'état reste « Inconnu ». Adresses vérifiées seulement.
# Des adresses enregistrées dans la page Paramètres remplacent celles-ci, sans redéployer.
WOW_STATUS_AUTH_TARGETS=
WOW_STATUS_GAME_TARGETS=
# Facultatifs : 300 s entre deux contrôles, 3000 ms sans réponse, dégradé à partir de 400 ms.
WOW_STATUS_INTERVAL_SECONDS=
WOW_STATUS_TIMEOUT_MS=
WOW_STATUS_DEGRADED_MS=

# Assistant de la page Opportunités (docs/ECONOMY-ENGINE.md), facultatif : vides, il est désactivé.
# Il ne reçoit que les faits du moteur et ne calcule rien.
# - Claude : WOW_AI_PROVIDER=anthropic et WOW_AI_API_KEY (clé d'API Anthropic). WOW_AI_MODEL
#   facultatif, claude-opus-5-5 par défaut ; WOW_AI_URL facultatif, https://api.anthropic.com.
# - API « chat completions » compatible OpenAI (Ollama, LM Studio…) : WOW_AI_PROVIDER vide,
#   WOW_AI_URL (adresse de base, sans /chat/completions) et WOW_AI_MODEL.
WOW_AI_PROVIDER=
WOW_AI_URL=
WOW_AI_MODEL=
# Envoyée en « Authorization: Bearer » ; facultative hors Claude. Secret : jamais dans le dépôt.
WOW_AI_API_KEY=
