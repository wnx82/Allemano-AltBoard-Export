# Copier en deploy/.env sur le serveur et renseigner. Ne jamais commiter le fichier rempli.

# Rôle applicatif dédié, base dédiée. Le code refuse toute base dont le nom ne commence pas par wow_altboard.
WOW_DATABASE_URL=postgres://wow_altboard_app:CHANGER@pgbouncer:6432/wow_altboard
# Rôle propriétaire, connexion directe : uniquement pour les migrations.
WOW_DATABASE_URL_DIRECT=postgres://wow_altboard_owner:CHANGER@pg-shared:5432/wow_altboard

WOW_APP_ORIGIN=https://wow.ekreativ.be
# Laisser vide sur un sous-domaine dédié ; "/wow" pour servir sous https://ekreativ.be/wow.
WOW_BASE_PATH=
WOW_TRUSTED_IP_HEADER=cf-connecting-ip
# Port local publié sur 127.0.0.1, à vérifier libre sur l'hôte avant le premier déploiement.
WOW_HOST_PORT=3016
WOW_IMAGE_TAG=latest
