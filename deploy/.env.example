# Copier en deploy/.env sur le serveur et renseigner. Ne jamais commiter le fichier rempli.
# Sur l'hôte contabo, les deux chaînes viennent de /srv/shared-db/secrets/wow_altboard.env
# (créé par « pgdb create wow_altboard ») : DATABASE_URL et DATABASE_URL_DIRECT.

# Connexion applicative, par PgBouncer. Le code refuse toute base dont le nom ne commence pas par wow_altboard.
WOW_DATABASE_URL=postgresql://wow_altboard:CHANGER@pgbouncer:6432/wow_altboard
# Connexion directe : uniquement pour les migrations.
WOW_DATABASE_URL_DIRECT=postgresql://wow_altboard:CHANGER@pg-shared:5432/wow_altboard

WOW_APP_ORIGIN=https://wow.ekreativ.be
# Laisser vide sur un sous-domaine dédié ; "/wow" pour servir sous https://ekreativ.be/wow.
WOW_BASE_PATH=
# Traefik pose X-Real-Ip. Ne mettre cf-connecting-ip que si le domaine est proxifié par Cloudflare
# ET que l'accès direct à l'origine est bloqué : sinon l'en-tête est falsifiable.
WOW_TRUSTED_IP_HEADER=x-real-ip
WOW_HOST_PORT=3016
WOW_IMAGE_TAG=latest
