# Copier en .env.local pour le développement. Ne jamais commiter de valeur réelle.
#
# Les noms sont préfixés WOW_ : un DATABASE_URL ou TEST_DATABASE_URL générique déjà présent
# dans l'environnement (autre projet) ne doit jamais être utilisé par celui-ci.
# Le code refuse toute base dont le nom ne commence pas par wow_altboard.

# Connexion applicative (PgBouncer en production).
WOW_DATABASE_URL=postgres://wow_altboard:dev-only-password@127.0.0.1:35432/wow_altboard

# Connexion directe pour les migrations (facultative : repli sur WOW_DATABASE_URL).
WOW_DATABASE_URL_DIRECT=postgres://wow_altboard:dev-only-password@127.0.0.1:35432/wow_altboard

# Base vidée par les tests d'intégration. Son nom doit finir par _test.
WOW_TEST_DATABASE_URL=postgres://wow_altboard:dev-only-password@127.0.0.1:35432/wow_altboard_test

# Origine publique du site (https://wow.ekreativ.be en production).
WOW_APP_ORIGIN=http://localhost:3000

# Chemin de base si l'application est servie sous un préfixe (vide sur un sous-domaine dédié).
WOW_BASE_PATH=
