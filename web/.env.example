# Copier en .env.local pour le développement. Ne jamais commiter de valeur réelle.
#
# Les noms sont préfixés WOW_ : un DATABASE_URL ou TEST_DATABASE_URL générique déjà présent
# dans l'environnement (autre projet) ne doit jamais être utilisé par celui-ci.
# Le code refuse toute base dont le nom ne commence pas par wow_altboard.

# Connexion applicative.
WOW_DATABASE_URL=postgres://wow_altboard:dev-only-password@127.0.0.1:35432/wow_altboard

# Connexion directe pour les migrations (facultative : repli sur WOW_DATABASE_URL).
WOW_DATABASE_URL_DIRECT=postgres://wow_altboard:dev-only-password@127.0.0.1:35432/wow_altboard

# Base vidée par les tests d'intégration. Son nom doit finir par _test.
WOW_TEST_DATABASE_URL=postgres://wow_altboard:dev-only-password@127.0.0.1:35432/wow_altboard_test

# Origine publique du site (https://wow.ekreativ.be en production).
WOW_APP_ORIGIN=http://localhost:3000

# Chemin de base si l'application est servie sous un préfixe (vide sur un sous-domaine dédié).
WOW_BASE_PATH=

# État des serveurs WoW Forever EU (page Serveurs, voir docs/SERVER-STATUS.md). Adresses sondées
# en TCP par ce serveur : « hôte:port », séparées par des virgules, huit au plus par service.
# Vides : rien n'est sondé et l'état reste « Inconnu ». Ne renseigner que des adresses vérifiées ;
# une adresse de bêta n'est pas celle de la production. Des adresses enregistrées dans la page
# Paramètres remplacent celles-ci, sans redéployer.
WOW_STATUS_AUTH_TARGETS=
WOW_STATUS_GAME_TARGETS=
# Facultatifs : secondes entre deux contrôles (300), délai sans réponse (3000 ms), latence à partir
# de laquelle un service qui répond est dit dégradé (400 ms).
WOW_STATUS_INTERVAL_SECONDS=
WOW_STATUS_TIMEOUT_MS=
WOW_STATUS_DEGRADED_MS=

# Assistant de la page Opportunités (docs/ECONOMY-ENGINE.md), facultatif : vides, il est désactivé.
# Il ne reçoit que les faits du moteur et ne calcule rien.
# - Claude : WOW_AI_PROVIDER=anthropic et WOW_AI_API_KEY (clé d'API Anthropic). WOW_AI_MODEL
#   facultatif, claude-opus-5-5 par défaut ; WOW_AI_URL facultatif, https://api.anthropic.com.
# - API « chat completions » compatible OpenAI (Ollama, LM Studio…) : WOW_AI_PROVIDER vide,
#   WOW_AI_URL (adresse de base, sans /chat/completions) et WOW_AI_MODEL.
WOW_AI_PROVIDER=
WOW_AI_URL=
WOW_AI_MODEL=
# Envoyée en « Authorization: Bearer » ; facultative hors Claude. Secret : jamais dans le dépôt.
WOW_AI_API_KEY=
